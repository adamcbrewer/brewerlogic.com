---
const isHome = Astro.url.pathname === '/';
const sectionPrefix = isHome ? '' : '/';
const isBlog = Astro.url.pathname === '/blog' || Astro.url.pathname.startsWith('/blog/');
const links = [
    { href: `${sectionPrefix}#about`, label: '#about' },
    { href: `${sectionPrefix}#work`, label: '#work' },
    { href: `${sectionPrefix}#experience`, label: '#experience' },
    { href: `${sectionPrefix}#contact`, label: '#contact' },
    { href: '/blog/', label: 'Thoughts' },
];
const current = Astro.url.pathname === '/blog/' || Astro.url.pathname === '/blog' ? 'page' : 'location';
---

<header data-site-header>
    <nav class="nav" aria-label="Main navigation">
        <a href={isHome ? '#main' : '/'} class="nav__logo">Adam Brewer</a>
        <ul class="nav__links">
            {links.map(({ href, label }) => (
                <li data-blog-link={href === '/blog/' ? '' : undefined}><a href={href} aria-current={isBlog && href === '/blog/' ? current : undefined}>{label}</a></li>
            ))}
        </ul>
        <button class="nav__toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-navigation">
            <span></span>
            <span></span>
        </button>
    </nav>
    <div class="nav__overlay" aria-hidden="true"></div>
    <ul class="nav__links--mobile" id="mobile-navigation" aria-hidden="true" inert>
        {links.map(({ href, label }) => (
            <li data-blog-link={href === '/blog/' ? '' : undefined}><a href={href} aria-current={isBlog && href === '/blog/' ? current : undefined}>{label}</a></li>
        ))}
    </ul>
</header>
<noscript>
    <nav class="noscript-nav" aria-label="Section navigation">
        <ul>
            {links.map(({ href, label }) => <li data-blog-link={href === '/blog/' ? '' : undefined}><a href={href}>{label}</a></li>)}
        </ul>
    </nav>
</noscript>
