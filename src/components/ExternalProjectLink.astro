---
interface Props {
    href: string;
}

const { href } = Astro.props;
---

<a class="external-project-link" href={href} target="_blank" rel="noopener noreferrer">
    <span class="link-text"><slot /></span>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false">
        <path d="M6 18 18 6M6 6h12v12" />
    </svg>
    <span class="sr-only">{' (opens in a new tab)'}</span>
</a>

<style>
    .external-project-link {
        display: inline-flex;
        align-items: center;
        gap: clamp(8px, 0.2em, 12px);
        max-width: 100%;
        transition: color 150ms;
    }

    .link-text {
        min-width: 0;
    }

    svg {
        flex: 0 0 auto;
        width: clamp(14px, 0.35em, 22px);
        height: clamp(14px, 0.35em, 22px);
        color: var(--site-accent);
        transition: transform 150ms ease;
    }

    .external-project-link:hover,
    .external-project-link:focus-visible {
        color: var(--site-accent);
    }

    .external-project-link:hover svg,
    .external-project-link:focus-visible svg {
        transform: translate(2px, -2px);
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
    }

    @media (prefers-reduced-motion: reduce) {
        .external-project-link,
        svg {
            transition: none;
        }

        .external-project-link:hover svg,
        .external-project-link:focus-visible svg {
            transform: none;
        }
    }
</style>
