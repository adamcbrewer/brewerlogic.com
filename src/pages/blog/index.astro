---
import '../../styles/blog.css';
import NumberedEntry from '../../components/NumberedEntry.astro';
import RSSLink from '../../components/RSSLink.astro';
import ListingLayout from '../../layouts/ListingLayout.astro';
import { getPosts } from '../../lib/posts';
import { getPostPath } from '../../lib/urls';
import { getSocialImage } from '../../lib/social-images';

const posts = await getPosts({ includeDrafts: import.meta.env.DEV });
---

<ListingLayout title="Thoughts" description="Notes on building software." canonicalPath="/blog/" image={getSocialImage(Astro.site)}>
    <link slot="head" rel="alternate" type="application/rss+xml" title="Thoughts / Adam Brewer" href={new URL('/blog/rss.xml', Astro.site).href} />
    <RSSLink slot="action" />
    {posts.length === 0 ? (
        <div class="empty-state">
            <p>No articles published yet.</p>
            <a href="/">Explore my work in the meantime</a>
        </div>
    ) : (
        <ul class="numbered-list">
            {posts.map((post, index) => (
                <NumberedEntry as="li" number={index + 1} headingLevel="h2" title={post.data.title} href={getPostPath(post.id)}>
                    <div slot="label" class="post-meta">
                        <time datetime={post.data.pubDate.toISOString()}>
                            {post.data.pubDate.toLocaleDateString('en-GB', { timeZone: 'UTC', dateStyle: 'long' })}
                        </time>
                        {post.data.draft && <span class="draft-label">Draft preview</span>}
                    </div>
                    <p>{post.data.description}</p>
                </NumberedEntry>
            ))}
        </ul>
    )}
</ListingLayout>
