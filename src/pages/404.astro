---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page Not Found / Adam Brewer" description="Find the portfolio, CV, case studies and agent-readable pages." pageClass="error-page" noindex>
    <section class="not-found">

        <p class="code">404 / Not found</p>
        <h1>Wrong Turn.</h1>
        <p>No resource exists at this URL. Use one of these indexes to find the portfolio, CV, case studies, privacy notice, or agent-readable Markdown.</p>
        <ul>
            <li><a href="/">Homepage</a></li>
            <li><a href="/sitemap.xml">Site map</a></li>
            <li><a href="/llms.txt">Agent guide</a></li>
        </ul>

    </section>
</SiteLayout>

<style>
    .not-found {
        width: min(720px, calc(100% - 48px));
        min-height: calc(100svh - 160px);
        margin-inline: auto;
        padding: calc(var(--site-header-height) + 64px) 0 64px;
        font-size: 0.875rem;
        line-height: 1.7;
    }

    .code {
        color: var(--site-accent);
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    h1 {
        margin: 12px 0 24px;
        font: clamp(4rem, 16vw, 9rem)/0.85 var(--font-display);
        letter-spacing: 0.02em;
        text-transform: uppercase;
    }

    p {
        max-width: 620px;
    }

    ul {
        display: flex;
        flex-wrap: wrap;
        gap: 16px 28px;
        margin-top: 32px;
        padding: 24px 0;
        border-block: 2px solid var(--site-border);
        list-style: none;
    }

    a {
        font-weight: 700;
        text-decoration: underline;
    }
</style>
