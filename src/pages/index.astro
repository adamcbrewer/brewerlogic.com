import SiteFooter from '../components/SiteFooter.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TWKH9DPEMN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-TWKH9DPEMN');
    </script>

    <title>Adam Brewer - Senior Full-Stack Engineer | TypeScript, React, GraphQL, Rust, Go &amp; AWS</title>
    <meta name="description" content="Senior full-stack engineer with 15+ years delivering fintech, SaaS and design-system products. TypeScript, React, Next.js, GraphQL, Rust, Go and AWS.">
    <meta name="author" content="Adam Brewer">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#25282c">
    <link rel="canonical" href="https://brewerlogic.com/">
    <link rel="alternate" type="text/markdown" href="https://brewerlogic.com/index.md">
    <link rel="describedby" href="https://brewerlogic.com/llms.txt">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Adam Brewer | Brewer Logic">
    <meta property="og:url" content="https://brewerlogic.com/">
    <meta property="og:title" content="Adam Brewer - Senior Full-Stack Engineer">
    <meta property="og:description" content="Frontend architecture, APIs and AWS serverless. Creator of Mapbox TUI and Rust contributor to Strata. TypeScript, React, Next.js, GraphQL and Go.">
