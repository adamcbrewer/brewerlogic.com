---
import '../styles/blog.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
    title: string;
    description: string;
    canonicalPath: string;
}

const { title, description, canonicalPath } = Astro.props;
const canonicalURL = new URL(canonicalPath, Astro.site).href;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <meta name="robots" content="noindex, nofollow" />
        <meta name="theme-color" content="#25282c" />
        <title>{title} | Adam Brewer</title>
        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" type="image/svg+xml" href="/assets/img/bl-logo.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
        <link rel="stylesheet" href="/assets/css/palette.css" />
        <link rel="stylesheet" href="/assets/css/navigation.css" />
        <script is:inline>document.documentElement.classList.add('js');</script>
        <script is:inline src="/assets/js/navigation.js" defer></script>
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to content</a>
        <SiteHeader />
        <main id="main" tabindex="-1"><slot /></main>
        <footer class="site-footer">
            <a class="site-logo" href="/">Adam Brewer</a>
            <a href="mailto:adam@brewerlogic.com">Get in touch</a>
            <a href="/privacy/">Privacy</a>
        </footer>
    </body>
</html>
