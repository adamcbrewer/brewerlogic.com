---
import '../styles/blog.css';
import '../styles/content.css';
import SiteLayout from './SiteLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { authorName } from '../lib/site';

interface Props {
    title: string;
    description: string;
    canonicalPath: string;
    article?: CollectionEntry<'blog'>['data'];
}

const { title, description, canonicalPath, article } = Astro.props;
const canonicalURL = new URL(canonicalPath, Astro.site).href;
const pageTitle = article ? `${title} / Thoughts / ${authorName}` : `${title} / ${authorName}`;
const image = article?.image;
const canIndex = !import.meta.env.DEV && !article?.draft;
const structuredData = article && {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    url: canonicalURL,
    mainEntityOfPage: canonicalURL,
    author: { '@type': 'Person', name: authorName, url: new URL('/', Astro.site).href },
    datePublished: article.pubDate.toISOString(),
    dateModified: article.updatedDate?.toISOString(),
    image: image?.url,
};
---

<SiteLayout
    title={pageTitle}
    description={description}
    canonicalPath={canonicalPath}
    markdownPath={canIndex && article ? `${canonicalPath}index.md` : undefined}
    pageClass={article ? 'article-page' : 'thoughts-page'}
    noindex={!canIndex}
    image={image}
    ogType={article ? 'article' : 'website'}
>
    <Fragment slot="head">
        <link rel="alternate" type="application/rss+xml" title="Thoughts / Adam Brewer" href={new URL('/blog/rss.xml', Astro.site).href} />
        {article && <>
            <meta property="article:author" content={new URL('/', Astro.site).href} />
            <meta property="article:published_time" content={article.pubDate.toISOString()} />
            {article.updatedDate && <meta property="article:modified_time" content={article.updatedDate.toISOString()} />}
        </>}
        {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
    </Fragment>
    <slot />
</SiteLayout>
